diff --git a/.github/workflows/coordinated_social_publish.yml b/.github/workflows/coordinated_social_publish.yml
new file mode 100644
index 0000000..c264096
--- /dev/null
+++ b/.github/workflows/coordinated_social_publish.yml
@@ -0,0 +1,173 @@
+name: Coordinated Daily Yield Social Publisher
+
+on:
+  schedule:
+    # Homepage plus four rotating top-row resources, spread across the IST day.
+    - cron: '45 23 * * *'  # 05:15 IST
+    - cron: '30 1 * * *'   # 07:00 IST
+    - cron: '30 4 * * *'   # 10:00 IST
+    - cron: '30 8 * * *'   # 14:00 IST
+    - cron: '30 14 * * *'  # 20:00 IST
+  workflow_dispatch:
+    inputs:
+      item_key:
+        description: 'master-N or news-desk key from the authenticated Blogger publisher'
+        required: false
+        default: ''
+        type: string
+      target_url:
+        description: 'Exact authenticated Blogger API destination'
+        required: false
+        default: ''
+        type: string
+      content_mode:
+        description: 'post for event dispatch; scheduled runs plan a page'
+        required: false
+        default: post
+        type: choice
+        options: [post, page]
+      published_at:
+        description: 'Blogger publication timestamp used for the 15-minute delay'
+        required: false
+        default: ''
+        type: string
+
+permissions:
+  contents: write
+
+concurrency:
+  group: coordinated-social-${{ inputs.item_key || github.event.schedule || github.run_id }}
+  cancel-in-progress: false
+
+jobs:
+  plan:
+    runs-on: ubuntu-latest
+    outputs:
+      platform: ${{ steps.route.outputs.platform }}
+      target_url: ${{ steps.route.outputs.target_url }}
+      content_mode: ${{ steps.route.outputs.content_mode }}
+      delay_seconds: ${{ steps.route.outputs.delay_seconds }}
+      item_key: ${{ steps.route.outputs.item_key }}
+    steps:
+      - uses: actions/checkout@v4
+      - id: route
+        shell: bash
+        run: |
+          python social_rotation.py \
+            --item-key '${{ inputs.item_key }}' \
+            --target-url '${{ inputs.target_url }}' \
+            --content-mode '${{ inputs.content_mode || 'page' }}' \
+            --published-at '${{ inputs.published_at }}' \
+            --schedule '${{ github.event.schedule }}'
+
+  facebook:
+    needs: plan
+    if: needs.plan.outputs.platform == 'facebook'
+    runs-on: ubuntu-latest
+    timeout-minutes: 25
+    steps:
+      - uses: actions/checkout@v4
+      - uses: actions/setup-python@v5
+        with: {python-version: '3.11'}
+      - run: python -m pip install --disable-pip-version-check requests pillow
+      - name: Wait until at least fifteen minutes after Blogger publication
+        run: sleep '${{ needs.plan.outputs.delay_seconds }}'
+      - name: Publish exact assigned destination to Facebook
+        env:
+          FACEBOOK_SYSTEM_USER_TOKEN: ${{ secrets.FACEBOOK_SYSTEM_USER_TOKEN }}
+          FACEBOOK_PAGE_ID: '1303333369533572'
+          FACEBOOK_GRAPH_VERSION: 'v26.0'
+          BLOGGER_BLOG_ID: ${{ secrets.BLOGGER_BLOG_ID }}
+          BLOGGER_CLIENT_ID: ${{ secrets.BLOGGER_CLIENT_ID }}
+          BLOGGER_CLIENT_SECRET: ${{ secrets.BLOGGER_CLIENT_SECRET }}
+          BLOGGER_REFRESH_TOKEN: ${{ secrets.BLOGGER_REFRESH_TOKEN }}
+        run: python facebook_publisher.py --content-mode '${{ needs.plan.outputs.content_mode }}' --target-url '${{ needs.plan.outputs.target_url }}'
+      - name: Persist Facebook tracker
+        run: |
+          git config user.name 'Daily Yield Facebook Bot'
+          git config user.email 'bot@dailyyield.blogspot.com'
+          git add facebook_tracker.json
+          git diff --staged --quiet || (git commit -m 'Record coordinated Facebook publication [skip ci]' && git pull --rebase origin main && git push origin main)
+
+  bluesky:
+    needs: plan
+    if: needs.plan.outputs.platform == 'bluesky' && vars.BLUESKY_AUTOMATION_ENABLED == 'true'
+    runs-on: ubuntu-latest
+    timeout-minutes: 25
+    steps:
+      - uses: actions/checkout@v4
+      - uses: actions/setup-python@v5
+        with: {python-version: '3.12'}
+      - run: python -m pip install --disable-pip-version-check requests pillow
+      - run: sleep '${{ needs.plan.outputs.delay_seconds }}'
+      - name: Publish exact assigned destination to Bluesky
+        env:
+          BLUESKY_HANDLE: 'dailyyield.bsky.social'
+          BLUESKY_APP_PASSWORD: ${{ secrets.BLUESKY_APP_PASSWORD }}
+          BLOGGER_BLOG_ID: ${{ secrets.BLOGGER_BLOG_ID }}
+          BLOGGER_CLIENT_ID: ${{ secrets.BLOGGER_CLIENT_ID }}
+          BLOGGER_CLIENT_SECRET: ${{ secrets.BLOGGER_CLIENT_SECRET }}
+          BLOGGER_REFRESH_TOKEN: ${{ secrets.BLOGGER_REFRESH_TOKEN }}
+        run: python bluesky_publisher.py --content-mode '${{ needs.plan.outputs.content_mode }}' --target-url '${{ needs.plan.outputs.target_url }}'
+      - name: Persist Bluesky tracker
+        run: |
+          git config user.name 'Daily Yield Bluesky Bot'
+          git config user.email 'bot@dailyyield.blogspot.com'
+          git add bluesky_tracker.json
+          git diff --staged --quiet || (git commit -m 'Record coordinated Bluesky publication [skip ci]' && git pull --rebase origin main && git push origin main)
+
+  tumblr:
+    needs: plan
+    if: needs.plan.outputs.platform == 'tumblr' && vars.TUMBLR_AUTOMATION_ENABLED == 'true'
+    runs-on: ubuntu-latest
+    timeout-minutes: 25
+    steps:
+      - uses: actions/checkout@v4
+      - uses: actions/setup-python@v5
+        with: {python-version: '3.12'}
+      - run: python -m pip install --disable-pip-version-check requests cryptography pillow
+      - run: sleep '${{ needs.plan.outputs.delay_seconds }}'
+      - name: Publish exact assigned destination to Tumblr
+        env:
+          TUMBLR_BLOG_IDENTIFIER: 'dailyyield-official'
+          TUMBLR_CONSUMER_KEY: ${{ vars.TUMBLR_CONSUMER_KEY }}
+          TUMBLR_CONSUMER_SECRET: ${{ secrets.TUMBLR_CONSUMER_SECRET }}
+          TUMBLR_TOKEN_ENCRYPTION_KEY: ${{ secrets.TUMBLR_TOKEN_ENCRYPTION_KEY }}
+          BLOGGER_BLOG_ID: ${{ secrets.BLOGGER_BLOG_ID }}
+          BLOGGER_CLIENT_ID: ${{ secrets.BLOGGER_CLIENT_ID }}
+          BLOGGER_CLIENT_SECRET: ${{ secrets.BLOGGER_CLIENT_SECRET }}
+          BLOGGER_REFRESH_TOKEN: ${{ secrets.BLOGGER_REFRESH_TOKEN }}
+        run: python tumblr_publisher.py --content-mode '${{ needs.plan.outputs.content_mode }}' --target-url '${{ needs.plan.outputs.target_url }}'
+      - name: Persist Tumblr token and tracker
+        run: |
+          git config user.name 'Daily Yield Tumblr Bot'
+          git config user.email 'bot@dailyyield.blogspot.com'
+          git add tumblr_token.enc tumblr_tracker.json
+          git diff --staged --quiet || (git commit -m 'Record coordinated Tumblr publication [skip ci]' && git pull --rebase origin main && git push origin main)
+
+  mastodon:
+    needs: plan
+    if: needs.plan.outputs.platform == 'mastodon' && vars.MASTODON_AUTOMATION_ENABLED == 'true'
+    runs-on: ubuntu-latest
+    timeout-minutes: 25
+    steps:
+      - uses: actions/checkout@v4
+      - uses: actions/setup-python@v5
+        with: {python-version: '3.12'}
+      - run: python -m pip install --disable-pip-version-check requests cryptography pillow
+      - run: sleep '${{ needs.plan.outputs.delay_seconds }}'
+      - name: Publish exact assigned destination to Mastodon
+        env:
+          MASTODON_INSTANCE: https://mastodon.social
+          MASTODON_TOKEN_KEY: ${{ secrets.MASTODON_TOKEN_KEY }}
+          BLOGGER_BLOG_ID: ${{ secrets.BLOGGER_BLOG_ID }}
+          BLOGGER_CLIENT_ID: ${{ secrets.BLOGGER_CLIENT_ID }}
+          BLOGGER_CLIENT_SECRET: ${{ secrets.BLOGGER_CLIENT_SECRET }}
+          BLOGGER_REFRESH_TOKEN: ${{ secrets.BLOGGER_REFRESH_TOKEN }}
+        run: python mastodon_publisher.py --content-mode '${{ needs.plan.outputs.content_mode }}' --target-url '${{ needs.plan.outputs.target_url }}'
+      - name: Persist Mastodon tracker
+        run: |
+          git config user.name 'Daily Yield Mastodon Bot'
+          git config user.email 'bot@dailyyield.blogspot.com'
+          git add mastodon_tracker.json
+          git diff --staged --quiet || (git commit -m 'Record coordinated Mastodon publication [skip ci]' && git pull --rebase origin main && git push origin main)
